#!/usr/bin/env bash

set -euo pipefail

launcher_path="${BASH_SOURCE[0]}"

while test -L "$launcher_path"; do
    link_target="$(readlink "$launcher_path")"
    case "$link_target" in
        /*) launcher_path="$link_target" ;;
        *) launcher_path="$(dirname "$launcher_path")/$link_target" ;;
    esac
done

launcher_dir="$(cd "$(dirname "$launcher_path")" && pwd)"
repo_root="$(cd "$launcher_dir/.." && pwd)"

exec uv run --script "$repo_root/scripts/library.py" "$@"
