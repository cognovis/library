.DS_Store
.env
*.tmp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Claude Code tool-internal cache
.claude/anatomy.json

# Codex/external session tracking (tool-internal, not project state)
.context/
.antigravitycli/
.cursor/
.codex/
.intake/

# Beads orchestrator transient IPC files
.worktree-handoff.json
.wave-orchestrator.lock

# Runtime artifacts (tool-generated, not project state)
.claude/buglog.json
.claude/worktrees/
tests/__pycache__/
**/__pycache__/
.session-close.lock
.session-close-state.json
.session-close-state.json.owned-manifest

# Library-installed primitives in this marketplace repo (source lives in top-level primitive dirs)
# No trailing slash: a linked worktree gets these as overlay *symlinks*
# (scripts/worktree-overlays.py), and git records a symlink as a file, so a
# directory-only pattern left every worktree permanently dirty.
.claude/agents/
.claude/skills
.agents/skills
.agents/standards/*
!.agents/standards/judge-layer/
!.agents/standards/judge-layer/**
.agents/agents/
.agents/prompts/
!.library.lock
.library.lock.workspace-lock
# Lockfile write guard and the staged file every atomic save replaces through.
.library.lock.lock
.library.lock.*.staged

# Beads JSONL export is local; Dolt is the source of truth.
.beads/issues.jsonl
.beads.gate.lock

