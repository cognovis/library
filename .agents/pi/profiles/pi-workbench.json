    },
    {
      "id": "beads-readonly-mcp",
      "kind": "mcp-boundary",
      "path": "project-native:pi-extension/acpx-workbench/dist/beads-readonly-mcp.js",
      "sha256": "4a1268b64654691c1f024f8762e4157669b5e7b00fb0c25f1b91ba1783c5b2f3",
      "source": "library:pi-extension/acpx-workbench"
    }
  ],
  "provider": {
    "id": "acpx-workbench",
    "default": "claude",
    "selections": {
      "claude": {
        "agent": "claude",
        "model": "claude:opus[1m]",
        "mode": "default",
        "route": ["Pi", "ACPX runtime", "Claude ACP adapter", "Claude"],
        "authContext": "normal Claude OAuth/config context",
        "isolationCapability": {
          "ambientUserSkills": "enforced",
          "warning": null
        },
        "adapter": {
          "command": ["node_modules/.bin/claude-agent-acp"],
          "version": "0.62.0",
          "provenance": "repository-package"
        }
      },
      "codex": {
        "agent": "codex",
        "model": "codex:gpt-5.6-sol",
        "mode": "read-only",
        "route": ["Pi", "ACPX runtime", "Codex ACP adapter", "Codex"],
        "authContext": "normal Codex login/config context",
        "isolationCapability": {
          "ambientUserSkills": "adapter-managed",
          "warning": null
        },
        "adapter": {
          "command": ["node_modules/.bin/codex-acp"],
          "version": "1.1.4",
          "provenance": "repository-package"
        }
      },
      "kimi": {
        "agent": "kimi",
        "model": "kimi:kimi-code/k3",
        "mode": "default",
        "route": ["Pi", "ACPX runtime", "Kimi ACP adapter", "Kimi"],
        "authContext": "normal Kimi CLI login/config context",
        "isolationCapability": {
          "ambientUserSkills": "not-supported",
          "warning": "Kimi CLI ACP exposes ambient user skills; managed cwd and MCP isolation remain enforced, while only adapter-emitted permission requests reach the host callback"
        },
        "adapter": {
          "command": ["kimi", "acp"],
          "provenance": "host-binary"
        }
      }
    },
    "models": {
      "claude": [
        "claude:opus[1m]",
        {
          "id": "claude:fable",
          "nativeModel": "claude:claude-fable-5[1m]"
        },
        "claude:sonnet",
        "claude:haiku"
      ],
      "codex": [
        "codex:gpt-5.6-sol",
        "codex:gpt-5.6-terra"
      ],
      "kimi": [
        "kimi:kimi-code/k3"
      ]
    }
  },
  "permissions": {
    "id": "repository-safe-v1",
    "acpxFallback": "deny-all",
    "downstreamMode": "default",
    "nonInteractive": "fail",
    "allowedTools": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "mcp__beads__beads_read",
      "mcp__open-brain__search",
      "mcp__open-brain__timeline",
      "mcp__open-brain__get_observations",
      "mcp__open-brain__search_by_concept",
      "mcp__open-brain__get_context",
      "mcp__open-brain__stats"
    ],
    "pathScope": "repository",
    "shell": "disabled",
    "network": "open-brain-readonly-proxy-only"
  },
  "isolation": {
    "piDiscovery": {
      "context": false,
      "skills": false,
      "extensions": false,
      "promptTemplates": false,
      "themes": false,
      "settings": false
    },
    "downstream": {
      "settingSources": [],
      "skills": [],
      "plugins": [],
      "mcpServers": {},
      "managedMcpServers": ["beads", "open-brain"],
      "hooks": false,
      "projectCwd": false
    }
  },
  "observability": {
    "events": "jsonl",
    "consumer": "workbench session",
    "retention": "durable"
  }
}
