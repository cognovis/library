  "id": "pi-workbench",
  "version": "2.0.0",
  "package": {
    "catalog": "library.yaml",
    "dependencyRoot": "just-module:pi-workbench"
  },
  "library": {
    "repository": "library:cognovis-core",
    "commit": "26a704b49e2f2dbf3fa5f6e6b22d7e95abe51e4d",
    "allowlist": ["golden-prompts/cognovis-base.md"]
  },
  "resources": [
